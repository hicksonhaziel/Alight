{
  "name": "@alight/workbench",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "predev": "node scripts/copy-methodology.mjs",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "node scripts/copy-methodology.mjs",
    "lint": "tsc --noEmit && eslint src",
    "build": "tsc --noEmit && vite build",

# Copy to .env. Actual credentials and authenticated URLs must remain local.
# Existing Solami account key; product permissions are checked independently.
SOLAMI_API_KEY=
SOLAMI_RPC_URL=
SOLAMI_RPC_TOKEN=
SOLAMI_GRPC_URL=https://grpc.solami.dev
SOLAMI_GRPC_TOKEN=

# Compatibility aliases for the bounded Aftershock-derived probe.
SOLAMI_STREAM_URL=https://grpc.solami.dev
SOLAMI_STREAM_TOKEN=

# Fill from the account dashboard when the shared key lacks product access.
SOLAMI_MIRAGE_URL=
SOLAMI_MIRAGE_TOKEN=
SOLAMI_MIRAGE_SUBSCRIPTION_ID=
SOLAMI_BLUR_URL=https://api.solami.dev
SOLAMI_BLUR_TOKEN=
SOLAMI_BLUR_WS_URL=wss://ws.solami.dev/data/subscribe
SOLAMI_DATA_API_URL=https://api.solami.dev
SOLAMI_DATA_API_TOKEN=
# Provider-issued signing secret returned when your actual webhook is created.
SOLAMI_WEBHOOK_SECRET=
SOLAMI_WEBHOOK_ID=
SOLAMI_WEBHOOK_WS_URL=
SOLAMI_WEBHOOK_TOKEN=

# Beam transport addresses; authentication is separate from the canary payer.
SOLAMI_BEAM_QUIC=beam.solami.dev:11000
# Candidate from public reference material; current HTTP contract is unverified.
SOLAMI_BEAM_HTTP=https://beam-http.solami.dev
# Base58 64-byte SWQoS identity keypair for the SDK, not just its public address.
SOLAMI_SWQOS_KEY=

# Dedicated canary wallet only. wallet:init can create it without funds.
# Base58-encoded 64-byte Solana keypair; never use a personal trading wallet.
ALIGHT_CANARY_KEYPAIR=
# Public address read by observe mode; signing keys are excluded from its config.
ALIGHT_CANARY_PUBKEY=
ALIGHT_DAILY_BUDGET_SOL=0.20
ALIGHT_BURST_BUDGET_SOL=0.05
ALIGHT_CANARY_INTERVAL_S=120
ALIGHT_UNIFORM_FRACTION=0.30
ALIGHT_SEED=1

# Read-only probes are the default. A funded pilot has not run yet.
ALIGHT_MODE=observe
ALIGHT_DB_PATH=./data/alight.db
ALIGHT_OPERATOR_KEY=
ALIGHT_PUBLIC_BASE_URL=http://localhost:8080
# Required for a real provider-to-Alight webhook delivery test.
ALIGHT_WEBHOOK_CALLBACK_URL=
ALIGHT_ALERT_WEBHOOK_URL=

# Local observe service. No signing or send route is enabled by alightd.
ALIGHT_BIND=127.0.0.1:8080
ALIGHT_DB_MAX_BYTES=536870912
# Replay capability is unverified; stay off until explicitly tested with the provider.
ALIGHT_GRPC_REPLAY_FROM_SLOT=false
ALIGHT_MIRAGE_ENABLED=true

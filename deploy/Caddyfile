{
	admin off
	auto_https off
	log {
		format filter {
			wrap json
			fields {
				request>uri delete
				request>headers delete
				request>remote_ip delete
				request>remote_port delete
				request>client_ip delete
			}
		}
	}
}
:80 {
	@readonly {
		method GET HEAD
		path /v1/health /v1/clock /v1/leaders /v1/curve /v1/quote /v1/prove/* /v1/proves /v1/ledger /v1/ledger/verify /v1/ledger/anchor /v1/ledger/payloads /v1/workbench /v1/diagnostics /v1/canaries/*/observations /v1/tape /v1/receipt/* /v1/observers /v1/openapi.json /v1/stream
	}
	handle @readonly {
		reverse_proxy collector:8080
	}
	@operator {
		method POST
		path /v1/quote /v1/prove
	}
	handle @operator {
		# The backend validates ALIGHT_OPERATOR_KEY before reading a request body.
		reverse_proxy collector:8080
	}
	@webhook {
		method POST
		path /v1/webhook
	}
	handle @webhook {
		# Exact body HMAC is checked by the backend; no operator bearer is required.
		reverse_proxy collector:8080
	}
	handle /v1/* {
		respond "Not found" 404
	}
	@datasets {
		method GET HEAD
		path /datasets/* /methodology/*
	}
	handle @datasets {
		root * /srv/alight
		file_server
	}
	@web method GET HEAD
	handle @web {
		root * /srv/alight
		try_files {path} /index.html
		file_server
	}
	handle {
		respond "Method not allowed" 405
	}
	header {
		X-Content-Type-Options nosniff
		Cache-Control no-store
		-Server
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		Referrer-Policy no-referrer
	}
	log {
		format filter {
			wrap json
			fields {
				request>uri delete
				request>headers delete
				request>remote_ip delete
				request>remote_port delete
				request>client_ip delete
			}
		}
	}
}

{
	admin off
	auto_https off
	log {
		format filter {
			wrap json
			fields {
				request>uri delete
				request>headers delete
				request>remote_ip delete
				request>remote_port delete
				request>client_ip delete
			}
		}
	}
}
:80 {
	@readonly {
		method GET HEAD
		path /v1/health /v1/clock /v1/leaders /v1/curve /v1/quote /v1/prove/* /v1/proves /v1/ledger /v1/ledger/verify /v1/tape /v1/observers /v1/openapi.json /v1/stream
	}
	handle @readonly {
		reverse_proxy collector:8080
	}
	@operator {
		method POST
		path /v1/quote /v1/prove
	}
	handle @operator {
		# The backend validates ALIGHT_OPERATOR_KEY before reading a request body.
		reverse_proxy collector:8080
	}
	handle {
		respond "Not found" 404
	}
	header {
		X-Content-Type-Options nosniff
		Cache-Control no-store
		-Server
	}
	log {
		format filter {
			wrap json
			fields {
				request>uri delete
				request>headers delete
				request>remote_ip delete
				request>remote_port delete
				request>client_ip delete
			}
		}
	}
}
